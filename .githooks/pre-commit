#!/usr/bin/env bash
# Bloquea commits directos a main (usa ramas + PR). Saltar solo en bootstrap/release:
#   ALLOW_MAIN_COMMIT=1 git commit ...
set -euo pipefail

branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo "")"
if [[ ("$branch" == "main" || "$branch" == "dev") && "${ALLOW_MAIN_COMMIT:-0}" != "1" ]]; then
  echo "✘ No se permiten commits directos a '$branch'. Crea una rama de tarea (skill git-workflow)." >&2
  echo "  (coordinador en release/setup: ALLOW_MAIN_COMMIT=1 git commit ...)" >&2
  exit 1
fi

# Evitar archivos pesados o generados por accidente
if git diff --cached --name-only | grep -qE '(^|/)(node_modules|target|dist)/'; then
  echo "✘ Estás agregando archivos generados (node_modules/target/dist)." >&2
  exit 1
fi
