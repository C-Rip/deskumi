#!/usr/bin/env bash
# Valida Conventional Commits. Activar: git config core.hooksPath .githooks
set -euo pipefail

msg_file="$1"
first_line="$(head -n1 "$msg_file")"

# Permitir merges, reverts automáticos y fixup/squash de rebase -i
if [[ "$first_line" =~ ^(Merge|Revert\ \"|fixup!|squash!|amend!) ]]; then
  exit 0
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'

if ! [[ "$first_line" =~ $pattern ]]; then
  cat >&2 <<EOF
✘ Mensaje de commit inválido:
    $first_line

Formato: <tipo>(<scope>)?: <resumen imperativo, ≤72 chars>
Tipos:   feat fix docs style refactor perf test build ci chore revert
Ejemplo: feat(avatar): load VRM models with VRMLoaderPlugin
Ver CONTRIBUTING.md
EOF
  exit 1
fi
